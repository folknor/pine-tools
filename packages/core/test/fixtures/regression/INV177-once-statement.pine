// @test regression/INV177-once-statement
// @description The `once [<condition>]` conditional structure TV added in August 2026: a side-effect-only block that runs on the first closed bar where its condition holds. Valid forms (conditioned, bare, nested in if, paren with no space) parse as OnceStatement; `once` stays a valid IDENTIFIER (`once = 3`, `int onceTyped = once`) because TV treats it as contextual; a non-bool condition is TV's CE10101 with blockName "once" at the condition; a user function whose tail is a once is void when assigned. Probed 2026-09-07, see INV177.
// @expects parse: success
// @expects ast: body.3.type = "OnceStatement"
// @expects ast: body.3.condition exists
// @expects ast: body.4.type = "OnceStatement"
// @expects ast: body.7.type = "VariableDeclaration"
// @expects error: line=16, column=6, message=/The condition of the "once" statement must evaluate to a "bool" value/
// @expects error: line=21, column=1, message=/Void expression cannot be assigned to a variable/
// @expects errors: 2

//@version=6
indicator("INV177 once")
var label lb = na
var int n = 0
once close > open
    lb := label.new(bar_index, high, "first up bar")
once
    n := 1
if bar_index > 10
    once close > open
        n := n + 1
once(bar_index > 3)
    n := n + 2
once = 3
int onceTyped = once
once close
    n := 2
f() =>
    once close > open
        label.new(bar_index, high, "x")
y = f()
f()
plot(n + onceTyped)
