// From piners scratch/spar/qual7.pine. Same check as qual5, but the series
// qualifier comes from mutation inside a `for` loop rather than a `:=` at
// top level. TV rejects at 7:72; we are clean.
//@version=6
indicator("qual7")

sum = 0
for i = 0 to 5
    sum := sum + i
plot(request.security(syminfo.tickerid, "60", close, calc_bars_count = sum))
